<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<jsp:include page="/views/common/header.jsp"><jsp:param name="pageTitle" value="Thêm sản phẩm"/></jsp:include>
<section class="container"><div class="row justify-content-center"><div class="col-lg-8"><div class="panel"><div class="section-label">Trang quản trị</div><h1 class="mb-4">Thêm sản phẩm</h1><c:if test="${not empty message}"><div class="alert alert-danger"><c:out value="${message}"/></div></c:if><form action="${pageContext.request.contextPath}/admin/product/add" method="post" enctype="multipart/form-data"><input type="hidden" name="csrfToken" value="${csrfToken}"><div class="row"><div class="col-md-8 mb-3"><label class="form-label" for="product_name">Tên sản phẩm</label><input id="product_name" class="form-control" name="product_name" value="${fn:escapeXml(param.product_name)}" maxlength="255" required></div><div class="col-md-4 mb-3"><label class="form-label" for="price">Giá bán (VNĐ)</label><input id="price" class="form-control" type="number" name="price" step="0.01" min="0.01" value="${fn:escapeXml(param.price)}" required></div></div><div class="mb-3"><label class="form-label" for="cate_id">Danh mục</label><select id="cate_id" class="form-select" name="cate_id" required><option value="">Chọn danh mục</option><c:forEach items="${categories}" var="c"><option value="${c.cate_id}" <c:if test="${param.cate_id == c.cate_id}">selected</c:if>><c:out value="${c.cate_name}"/></option></c:forEach></select></div><div class="mb-3"><label class="form-label" for="description">Mô tả</label><textarea id="description" class="form-control" name="description"><c:out value="${param.description}"/></textarea></div><div class="mb-4"><label class="form-label" for="image">Ảnh sản phẩm</label><input id="image" class="form-control" type="file" name="image" accept="image/jpeg,image/png,image/webp,image/gif"><div class="form-text">JPG, PNG, WEBP hoặc GIF; tối đa 5 MB.</div></div><div class="d-flex gap-2"><button class="btn btn-primary" type="submit">Lưu sản phẩm</button><a class="btn btn-outline-secondary" href="${pageContext.request.contextPath}/admin/product">Hủy</a><a class="btn btn-outline-dark ms-auto" href="${pageContext.request.contextPath}/admin/category/add">Thêm danh mục</a></div></form></div></div></div></section><jsp:include page="/views/common/footer.jsp"/>
