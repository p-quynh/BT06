<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<jsp:include page="/views/common/header.jsp"><jsp:param name="pageTitle" value="Cập nhật sản phẩm"/></jsp:include>
<section class="container"><div class="row justify-content-center"><div class="col-lg-8"><div class="panel"><div class="section-label">Trang quản trị</div><h1 class="mb-4">Cập nhật sản phẩm</h1><c:if test="${not empty message}"><div class="alert alert-danger"><c:out value="${message}"/></div></c:if><form action="${pageContext.request.contextPath}/admin/product/edit" method="post" enctype="multipart/form-data"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="product_id" value="${product.product_id}"><div class="row"><div class="col-md-8 mb-3"><label class="form-label" for="product_name">Tên sản phẩm</label><input id="product_name" class="form-control" name="product_name" value="${fn:escapeXml(not empty param.product_name ? param.product_name : product.product_name)}" maxlength="255" required></div><div class="col-md-4 mb-3"><label class="form-label" for="price">Giá bán (VNĐ)</label><input id="price" class="form-control" type="number" name="price" step="0.01" min="0.01" value="${fn:escapeXml(not empty param.price ? param.price : product.price)}" required></div></div><div class="mb-3"><label class="form-label" for="cate_id">Danh mục</label><select id="cate_id" class="form-select" name="cate_id" required><c:forEach items="${categories}" var="c"><option value="${c.cate_id}" <c:if test="${(not empty param.cate_id and param.cate_id == c.cate_id) or (empty param.cate_id and c.cate_id == product.category.cate_id)}">selected</c:if>><c:out value="${c.cate_name}"/></option></c:forEach></select></div><div class="mb-3"><label class="form-label" for="description">Mô tả</label><textarea id="description" class="form-control" name="description"><c:out value="${not empty param.description ? param.description : product.description}"/></textarea></div><c:if test="${not empty product.image}"><div class="mb-3"><div class="form-label">Ảnh hiện tại</div><img src="${pageContext.request.contextPath}/uploads/products/${fn:escapeXml(product.image)}" width="150" height="150" style="object-fit:cover" alt="Ảnh sản phẩm"></div></c:if><div class="mb-4"><label class="form-label" for="image">Chọn ảnh mới</label><input id="image" class="form-control" type="file" name="image" accept="image/jpeg,image/png,image/webp,image/gif"><div class="form-text">Để trống nếu muốn giữ ảnh hiện tại.</div></div><div class="d-flex gap-2"><button class="btn btn-primary" type="submit">Cập nhật</button><a class="btn btn-outline-secondary" href="${pageContext.request.contextPath}/admin/product">Quay lại danh sách</a></div></form></div></div></div></section><jsp:include page="/views/common/footer.jsp"/>
