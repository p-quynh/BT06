<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<jsp:include page="/views/common/header.jsp"><jsp:param name="pageTitle" value="Thông tin cá nhân"/></jsp:include>
<section class="container"><div class="row g-4"><div class="col-lg-4"><div class="panel text-center"><c:if test="${not empty user.avatar}"><img class="avatar-preview mb-3" src="${pageContext.request.contextPath}/uploads/avatar/${fn:escapeXml(user.avatar)}" alt="Ảnh đại diện"></c:if><h2 class="h4"><c:out value="${user.fullname}"/></h2><p class="text-muted mb-0"><c:out value="${user.email}"/></p><div class="d-grid gap-2 mt-4"><a class="btn btn-outline-dark" href="${pageContext.request.contextPath}/product">Xem sản phẩm</a><a class="btn btn-outline-secondary" href="${pageContext.request.contextPath}/home">Về trang chủ</a></div></div></div><div class="col-lg-8"><div class="panel"><div class="page-heading"><div class="section-label">Tài khoản</div><h1>Thông tin cá nhân</h1></div><c:if test="${not empty error}"><div class="alert alert-danger"><c:out value="${error}"/></div></c:if><form action="${pageContext.request.contextPath}/profile" method="post" enctype="multipart/form-data"><div class="mb-3"><label class="form-label" for="avatar">Ảnh đại diện mới</label><input id="avatar" type="file" class="form-control" name="avatar" accept="image/jpeg,image/png,image/webp,image/gif"><div class="form-text">Định dạng JPG, PNG, WEBP hoặc GIF; tối đa 5 MB.</div></div><div class="row"><div class="col-md-6 mb-3"><label class="form-label">Tên đăng nhập</label><input class="form-control" value="${fn:escapeXml(user.username)}" readonly></div><div class="col-md-6 mb-3"><label class="form-label">Email</label><input class="form-control" value="${fn:escapeXml(user.email)}" readonly></div></div><div class="mb-3"><label class="form-label" for="fullname">Họ và tên</label><input id="fullname" name="fullname" class="form-control" value="${fn:escapeXml(user.fullname)}" required maxlength="255"></div><div class="mb-4"><label class="form-label" for="phone">Số điện thoại</label><input id="phone" name="phone" class="form-control" value="${fn:escapeXml(user.phone)}" pattern="[0-9]{10}" required inputmode="numeric"></div><button class="btn btn-primary" type="submit">Cập nhật thông tin</button></form></div></div></div></section>
<jsp:include page="/views/common/footer.jsp"/>
