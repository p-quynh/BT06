<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<jsp:include page="/views/common/header.jsp"><jsp:param name="pageTitle" value="Chi tiết sản phẩm"/></jsp:include>
<section class="container"><div class="mb-4"><a class="btn btn-outline-dark" href="${pageContext.request.contextPath}/product">← Quay lại danh sách</a></div><div class="row g-5 align-items-start"><div class="col-lg-6"><c:choose><c:when test="${not empty product.image}"><img class="img-fluid w-100 border" style="max-height:580px;object-fit:cover" src="${pageContext.request.contextPath}/uploads/products/${fn:escapeXml(product.image)}" alt="${fn:escapeXml(product.product_name)}"></c:when><c:otherwise><div class="empty-state" style="min-height:380px">Chưa có ảnh sản phẩm</div></c:otherwise></c:choose></div><div class="col-lg-6"><div class="section-label">Chi tiết sản phẩm</div><h1 class="display-5"><c:out value="${product.product_name}"/></h1><div class="price fs-3 my-3"><c:out value="${product.price}"/> VNĐ</div><hr><p class="text-muted mb-1">Danh mục</p><p class="fw-bold"><c:out value="${product.category.cate_name}"/></p><p class="text-muted mb-1">Mô tả</p><p style="white-space:pre-wrap"><c:out value="${product.description}"/></p><div class="d-flex gap-2 mt-4"><a class="btn btn-primary" href="${pageContext.request.contextPath}/product">Tiếp tục mua sắm</a><a class="btn btn-outline-dark" href="${pageContext.request.contextPath}/home">Trang chủ</a></div></div></div></section>
<jsp:include page="/views/common/footer.jsp"/>
