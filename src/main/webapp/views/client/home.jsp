<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<jsp:include page="/views/common/header.jsp"><jsp:param name="pageTitle" value="Trang chủ"/></jsp:include>
<section class="hero"><div class="hero-content"><div class="eyebrow">Bộ sưu tập mới</div><h1>Bước đi khác biệt cùng UTE Footwear</h1><p>Khám phá những thiết kế thời trang mới nhất, được chọn lọc cho phong cách năng động mỗi ngày.</p><a class="btn btn-primary btn-lg" href="${pageContext.request.contextPath}/product">Mua sắm ngay</a></div></section>
<section class="container"><div class="page-heading d-flex justify-content-between align-items-end gap-3"><div><div class="section-label">Vừa cập nhật</div><h2>Sản phẩm mới nhất</h2></div><a class="btn btn-outline-dark" href="${pageContext.request.contextPath}/product">Xem tất cả</a></div>
<c:choose><c:when test="${empty products}"><div class="empty-state">Chưa có sản phẩm. Hãy quay lại sau nhé.</div></c:when><c:otherwise><div class="product-grid"><c:forEach items="${products}" var="p"><article class="product-card"><a class="product-card-media" href="${pageContext.request.contextPath}/product-detail?id=${p.product_id}"><c:choose><c:when test="${not empty p.image}"><img src="${pageContext.request.contextPath}/uploads/products/${fn:escapeXml(p.image)}" alt="${fn:escapeXml(p.product_name)}"></c:when><c:otherwise><span class="d-flex h-100 align-items-center justify-content-center text-muted">Chưa có ảnh</span></c:otherwise></c:choose></a><div class="product-card-body"><h3><c:out value="${p.product_name}"/></h3><div class="price"><c:out value="${p.price}"/> VNĐ</div><a class="btn btn-sm btn-outline-dark mt-3" href="${pageContext.request.contextPath}/product-detail?id=${p.product_id}">Xem chi tiết</a></div></article></c:forEach></div></c:otherwise></c:choose></section>
<jsp:include page="/views/common/footer.jsp"/>
