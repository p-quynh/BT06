<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<jsp:include page="/views/common/header.jsp"><jsp:param name="pageTitle" value="Sản phẩm"/></jsp:include>
<section class="container"><div class="page-heading"><div class="section-label">Cửa hàng</div><h1>Tất cả sản phẩm</h1><p class="text-muted">Chọn sản phẩm phù hợp với phong cách của bạn.</p></div>
<c:choose><c:when test="${empty products}"><div class="empty-state">Chưa có sản phẩm để hiển thị. <a href="${pageContext.request.contextPath}/home">Về trang chủ</a></div></c:when><c:otherwise><div class="product-grid"><c:forEach items="${products}" var="p"><article class="product-card"><a class="product-card-media" href="${pageContext.request.contextPath}/product-detail?id=${p.product_id}"><c:choose><c:when test="${not empty p.image}"><img src="${pageContext.request.contextPath}/uploads/products/${fn:escapeXml(p.image)}" alt="${fn:escapeXml(p.product_name)}"></c:when><c:otherwise><span class="d-flex h-100 align-items-center justify-content-center text-muted">Chưa có ảnh</span></c:otherwise></c:choose></a><div class="product-card-body"><h3><c:out value="${p.product_name}"/></h3><div class="price"><c:out value="${p.price}"/> VNĐ</div><a class="btn btn-sm btn-primary mt-3" href="${pageContext.request.contextPath}/product-detail?id=${p.product_id}">Chi tiết sản phẩm</a></div></article></c:forEach></div></c:otherwise></c:choose>
<c:if test="${totalPages > 1}"><nav class="mt-5" aria-label="Phân trang"><ul class="pagination justify-content-center"><c:forEach begin="0" end="${totalPages - 1}" var="i"><li class="page-item ${i == currentPage ? 'active' : ''}"><a class="page-link" href="${pageContext.request.contextPath}/product?page=${i}">${i + 1}</a></li></c:forEach></ul></nav></c:if></section>
<jsp:include page="/views/common/footer.jsp"/>
