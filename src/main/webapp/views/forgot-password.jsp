<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<jsp:include page="/views/common/header.jsp"><jsp:param name="pageTitle" value="Quên mật khẩu"/></jsp:include>
<section class="container auth-shell"><div class="auth-card"><div class="section-label">Khôi phục tài khoản</div><h1>Quên mật khẩu</h1><p class="text-muted">Nhập email đã đăng ký, chúng tôi sẽ gửi mã xác nhận OTP.</p><c:if test="${not empty message}"><div class="alert alert-danger"><c:out value="${message}"/></div></c:if><form action="${pageContext.request.contextPath}/forgot-password" method="post"><div class="mb-4"><label class="form-label" for="email">Email</label><input id="email" class="form-control" type="email" name="email" maxlength="255" required autocomplete="email"></div><button class="btn btn-primary w-100" type="submit">Gửi mã OTP</button></form><div class="d-flex justify-content-between mt-4"><a href="${pageContext.request.contextPath}/login">← Đăng nhập</a><a href="${pageContext.request.contextPath}/register">Đăng ký</a></div></div></section><jsp:include page="/views/common/footer.jsp"/>
