<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<jsp:include page="/views/common/header.jsp"><jsp:param name="pageTitle" value="Đăng ký"/></jsp:include>
<section class="container auth-shell"><div class="auth-card"><div class="section-label">Thành viên mới</div><h1 class="mb-2">Đăng ký tài khoản</h1><p class="text-muted mb-4">Tạo tài khoản để cập nhật hồ sơ và trải nghiệm cửa hàng.</p><c:if test="${not empty error or not empty message}"><div class="alert alert-danger"><c:out value="${not empty error ? error : message}"/></div></c:if><form action="${pageContext.request.contextPath}/register" method="post"><div class="mb-3"><label class="form-label" for="email">Email</label><input id="email" class="form-control" type="email" name="email" value="${fn:escapeXml(email)}" maxlength="255" required autocomplete="email"></div><div class="mb-3"><label class="form-label" for="username">Tên đăng nhập</label><input id="username" class="form-control" type="text" name="username" value="${fn:escapeXml(username)}" minlength="3" maxlength="100" required autocomplete="username"></div><div class="mb-3"><label class="form-label" for="fullname">Họ và tên</label><input id="fullname" class="form-control" type="text" name="fullname" value="${fn:escapeXml(fullname)}" maxlength="255" required autocomplete="name"></div><div class="mb-3"><label class="form-label" for="phone">Số điện thoại</label><input id="phone" class="form-control" type="tel" name="phone" value="${fn:escapeXml(phone)}" pattern="[0-9]{10}" maxlength="10" required inputmode="numeric" placeholder="Ví dụ: 0912345678"></div><div class="mb-4"><label class="form-label" for="password">Mật khẩu</label><input id="password" class="form-control" type="password" name="password" minlength="6" maxlength="72" required autocomplete="new-password"></div><button class="btn btn-primary w-100" type="submit">Đăng ký</button></form><p class="text-center mt-4 mb-0">Đã có tài khoản? <a href="${pageContext.request.contextPath}/login">Đăng nhập</a></p></div></section>
<jsp:include page="/views/common/footer.jsp"/>
